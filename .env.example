# ── Centinela · variables de entorno ───────────────────────────────────
# Copia este archivo a `.env` y ajusta por entorno. NUNCA versiones `.env`;
# este ejemplo sí se versiona (documentación). Cárgalo con:
#   node --env-file=.env src/server.ts
# o en desarrollo:
#   node --env-file=.env --watch src/server.ts

# ── Red ────────────────────────────────────────────────────────────────
PORT=4000
# 127.0.0.1 = solo esta máquina (desarrollo). 0.0.0.0 = expone a la red:
# úsalo SOLO con HTTPS y RP_ID de dominio real (ver docs/08-canal-cruzado.md).
HOST=127.0.0.1

# ── WebAuthn ───────────────────────────────────────────────────────────
RP_NAME=Centinela
# Desarrollo en esta máquina: localhost (válido solo en el propio dispositivo).
# Producción / móvil: tu dominio registrable (ej. firmas.empresa.com) vía
# túnel HTTPS o proxy con certificado. Las llaves registradas con localhost
# NO valen para otro RP_ID: hay que volver a registrarlas.
RP_ID=localhost
ORIGIN=http://localhost:4000

# ── Almacén ────────────────────────────────────────────────────────────
MONGO_URL=mongodb://127.0.0.1:27017/centinela
# mongo = MongoDB real. mock = todo en memoria (demo sin base de datos):
# úsalo solo para demostraciones, nunca para probar persistencia.
CENTINELA_STORE=mongo

# ── Idempotencia (ver docs/03-api.md) ──────────────────────────────────
# Ventana en segundos de la clave derivada (red de seguridad sin header):
# mismo payload dentro de la ventana = mismo envío, no se duplica.
IDEMPOTENCY_WINDOW_SECONDS=60

# ── Auditoría · anclaje externo (ver docs/05-auditoria.md) ─────────────
# Archivo append-only fuera de Mongo (no versionar; respáldalo aparte).
ANCHOR_FILE=anchors.log
# Cada cuántas entradas se publica la cabeza de la cadena fuera de Mongo.
ANCHOR_EVERY=50
# Copia externa REAL (un atacante con admin de Mongo no llega hasta ella):
# webhook o servicio de correo en otro sistema.
# ANCHOR_WEBHOOK_URL=https://tusistema.com/anclas
# Umbral de "silencio": minutos sin un anclaje externo exitoso antes de que
# el panel alerte (aunque no haya ningún evento de fallo visible).
ANCHOR_STALENESS_MINUTES=60
